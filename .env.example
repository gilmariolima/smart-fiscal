TP_AMB=2                       # 2 = homologação (padrão seguro) | 1 = produção
MASTER_KEY=                    # 64 caracteres hex; gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_CAPTURA=0 8,13 * * *       # todo dia às 8h e às 13h
INTERVALO_ENTRE_CHAMADAS_MS=2000
MAX_CONSULTAS_CHAVE_POR_CICLO=20
MAX_TENTATIVAS_DOWNLOAD=5
PAINEL_PORTA=3030
PAINEL_HOST=127.0.0.1          # só acessível no próprio PC
PAINEL_SENHA=                  # obrigatória se PAINEL_HOST não for 127.0.0.1
PASTA_XMLS=./xmls
PASTA_EXPORTS=./exports
PASTA_CERTS=./certs
# Opcionais (padrão ./data e ./logs):
# PASTA_DADOS=./data
# PASTA_LOGS=./logs
# PASTA_BACKUP=D:\Backup\SmartFiscal   # backup automático diário (outro disco, pendrive ou pasta sincronizada); vazio = desligado
# SEFAZ_MOCK=1                 # usa a SEFAZ simulada (demonstração sem certificado)
